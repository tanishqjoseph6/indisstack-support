# OpenAI (optional — live message analysis)
OPENAI_API_KEY=

# Public demo mode — skips /api/analyze and Supabase inbox persistence
NEXT_PUBLIC_DEMO_MODE=false

# Supabase (optional — inbox persistence + authentication)
# Public — safe for browser bundles when prefixed with NEXT_PUBLIC_
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional server-only URL fallback (not exposed to the browser)
SUPABASE_URL=

# Server only — never expose to the browser or NEXT_PUBLIC_*
SUPABASE_SERVICE_ROLE_KEY=

# Auth redirect URL (configure in Supabase dashboard):
# Site URL: http://localhost:3000
# Redirect URLs: http://localhost:3000/auth/callback
